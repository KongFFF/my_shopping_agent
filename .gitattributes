# Repair manifests bind exact artifact bytes across Windows and AutoDL.
# -text disables newline conversion; text diffs remain available.
/repairs/** -text
/experiments/purchase_guard_v1/** -text
# Unified diff context lines intentionally start with one space.
/experiments/purchase_guard_v1/*/runtime.patch whitespace=-blank-at-eol
/experiments/purchase_guard_v1_1/** -text
/experiments/purchase_guard_v1_1/*/runtime.patch whitespace=-blank-at-eol
/experiments/semantic_contract_v1/** -text
/experiments/semantic_contract_v2/** -text
/experiments/semantic_contract_v2_r3/** -text
/experiments/semantic_contract_v2_r4/** -text
/experiments/semantic_reference_v1/** -text
/experiments/semantic_holdout50_v1/** -text
/analysis/purchase_guard_v1_1_dev50_20261031/** -text

# These sources are fingerprinted or embedded in generated runtime modules.
/tools/*task_contract_v*.py text eol=lf

# Preserve frozen audit input bytes and runtime snapshot hashes on every OS.
/analysis/** -text
/experiments/semantic_*/** -text
/experiments/evidence_training_runtime_v1/** -text
/experiments/purchase_judge_v1/** -text
/experiments/purchase_facts_v2/** -text
/tools/*.py text eol=lf
# Preserve the already-audited scorer bytes bound into the experiment manifests.
/tools/purchase_judge_benchmark.py whitespace=-blank-at-eof

# CRLF is intentional in byte-frozen historical records; diff context lines
# in saved patches may consist of a single leading space.
/analysis/** whitespace=cr-at-eol
/analysis/**/*.md whitespace=cr-at-eol,-blank-at-eof
/repairs/** whitespace=cr-at-eol
/experiments/semantic_*/** whitespace=cr-at-eol
/experiments/evidence_training_runtime_v1/** whitespace=cr-at-eol
*.patch whitespace=cr-at-eol,-blank-at-eol
/.gitattributes text eol=lf
/.gitignore text eol=lf
