# Repair manifests bind exact artifact bytes across Windows and AutoDL.
# -text disables newline conversion; text diffs remain available.
/repairs/** -text
/experiments/purchase_guard_v1/** -text
# Unified diff context lines intentionally start with one space.
/experiments/purchase_guard_v1/*/runtime.patch whitespace=-blank-at-eol
/experiments/purchase_guard_v1_1/** -text
/experiments/purchase_guard_v1_1/*/runtime.patch whitespace=-blank-at-eol

# These sources are fingerprinted or embedded in generated runtime modules.
/tools/*task_contract_v*.py text eol=lf
